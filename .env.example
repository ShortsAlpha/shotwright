# Copy to .env.local and fill in. Never commit .env.local.

# Meta Model API (https://dev.meta.ai/docs/quickstart)
MUSE_API_KEY=

# Optional: Muse Spark Open on Baseten (model: meta-models/muse-spark-open-1026)
BASETEN_API_KEY=

# Optional: ElevenLabs, for narrated previews
ELEVENLABS_API_KEY=

# Server guardrails (defaults in apps/web/lib/limits.ts)
# SHOTWRIGHT_SESSION_EXPLORE_PER_HOUR=3
# SHOTWRIGHT_DAILY_EXPLORE_CAP=50          # 0 turns Explore off
# SHOTWRIGHT_SESSION_CAPTIONS_PER_HOUR=10
# SHOTWRIGHT_DAILY_CAPTIONS_CAP=200
# SHOTWRIGHT_RENDERER_IDLE_MS=60000        # close Chromium after this much idle time
# SHOTWRIGHT_FAKE_MODELS=1                 # scripted models for demos without keys
# SHOTWRIGHT_DATA_DIR=.shotwright          # where session runs are stored
